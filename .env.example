# Modèle du fichier .env : copiez-le en ".env" puis remplissez les valeurs.
# Le vrai fichier .env contient des secrets : il ne doit jamais aller dans Git.

# Clé secrète de Flask, qui signe les cookies de session (connexion).
# Pour en générer une :
#   python3 -c "import secrets; print(secrets.token_hex(32))"
SECRET_KEY=

# Clé de l'API Mistral (utilisée par test.py).
MISTRAL_API_KEY=

# --- Facultatif : utilisé en production (Render les définit lui-même) ---
# Adresse d'une base PostgreSQL. Sans elle, l'application utilise SQLite.
# DATABASE_URL=postgresql://utilisateur:motdepasse@serveur:5432/base
# Active les réglages de production (HTTPS obligatoire).
# PRODUCTION=1
# Adresse publique du site, pour les liens envoyés par e-mail
# (par défaut : http://localhost:5000).
# ADRESSE_DU_SITE=https://webapp-noms.onrender.com

# --- Facultatif : envoi réel des e-mails par Brevo ---
# Sans BREVO_API_KEY, les e-mails ne sont pas envoyés : ils s'affichent
# dans le terminal (pratique en développement).
# BREVO_API_KEY=
# EMAIL_EXPEDITEUR=adresse-validee-dans-brevo@example.com
# NOM_EXPEDITEUR=webapp-noms
